# ==============================================================================
# Microsoft Azure / SharePoint API Credentials (Microsoft Graph API)
# ==============================================================================
# Azure AD Tenant ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Registered App Client ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Registered App Client Secret
AZURE_CLIENT_SECRET=your_client_secret_here

# SharePoint Site ID (format: domain.sharepoint.com,site-id,web-id)
SHAREPOINT_SITE_ID=yourtenant.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000

# SharePoint List ID or Name to ingest
SHAREPOINT_LIST_ID=your_list_name_or_guid

# ==============================================================================
# Snowflake Connection Parameters
# ==============================================================================
# Snowflake Account Identifier (e.g. xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1

SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ETL_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=COR_DB
SNOWFLAKE_SCHEMA=BRONZE
